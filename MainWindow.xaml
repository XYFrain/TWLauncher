<Window x:Class="TWLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="时之旅者"
        Icon="Images/时旅@256x256.ico"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
        <!-- 主界面 -->
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="Images/bg.png" Stretch="UniformToFill"/>
            </Border.Background>
            <Grid>
                <!-- 顶部拖动区域 -->
                <Rectangle Height="64" VerticalAlignment="Top" Fill="Transparent" MouseLeftButtonDown="DragMove"/>

                <!-- 右上角控制按钮 -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Orientation="Horizontal">
                    <Button Style="{StaticResource Setting}" Margin="0,0,12,0" Command="{Binding OpenSettingsCommand}"/>
                    <Button Style="{StaticResource Minimize}" Margin="0,0,12,0" Click="Minimize"/>
                    <Button Style="{StaticResource Close}" Margin="0,0,12,0" Click="Close"/>
                </StackPanel>

                <!-- 右下角操作区 -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,64">
                    <Button Content="{Binding MainButtonVM.MainButtonText}" IsEnabled="{Binding MainButtonVM.MainButtonEnabled}" Style="{StaticResource GameAction}" Command="{Binding GameActionCommand}"/>
                </StackPanel>

                <!-- 底部下载进度栏 -->
                <StackPanel Visibility="{Binding ProgressVM.Visibility}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="24,0,24,16">
                    <Grid>
                        <TextBlock Text="{Binding ProgressVM.StageText}" HorizontalAlignment="Left"
                                   Foreground="#2B2B2B" FontFamily="Microsoft YaHei" FontSize="16" FontWeight="Bold"/>
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="#2B2B2B" FontFamily="Microsoft YaHei" FontSize="16" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:F0}%">
                                    <Binding Path="ProgressVM.Percent"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Style="{StaticResource GameProgressBar}" Height="16" Margin="0,4,0,0"
                                 Value="{Binding ProgressVM.Percent}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 设置面板 -->
        <Grid Visibility="{Binding SettingsVM.Visibility}" Panel.ZIndex="1">
            <Border Background="#AA000000"/>
            <Grid Width="720" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- 关闭按钮-->
                <Button Style="{StaticResource Close}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Panel.ZIndex="1" Command="{Binding CloseSettingsCommand}"/>
                
                <Border Background="#2B2B2B" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 侧边栏 -->
                        <Border Grid.Column="0" Background="#232323" CornerRadius="8,0,0,8">
                            <StackPanel Margin="16,24,16,16">
                                <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,32" FontFamily="Microsoft YaHei"/>
                                <RadioButton x:Name="NavGeneral" Content="常规" Style="{StaticResource SettingsNavButton}" IsChecked="True" Tag="General"/>
                                <RadioButton x:Name="NavGame" Content="游戏" Style="{StaticResource SettingsNavButton}" Tag="Game"/>
                                <RadioButton x:Name="NavAbout" Content="关于" Style="{StaticResource SettingsNavButton}" Tag="About"/>
                            </StackPanel>
                        </Border>

                        <!-- 内容区 -->
                        <Grid Grid.Column="1" Margin="24">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <!-- 常规页 -->
                                    <Grid Visibility="{Binding IsChecked, ElementName=NavGeneral, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Margin="0,8,0,0">
                                            <!-- Java 路径 -->
                                             <TextBlock Text="Java 路径" Foreground="#E0E0E0" FontFamily="Microsoft YaHei" FontSize="14" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding SettingsVM.JavaPathList}"
                                                          SelectedValue="{Binding SettingsVM.JavaPath, Mode=TwoWay}"
                                                          SelectedValuePath="Path"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{StaticResource SettingsComboBox}"
                                                          Grid.Column="0"/>
                                                <Button Content="浏览"
                                                        Command="{Binding SettingsVM.BrowseJavaCommand}"
                                                        Style="{StaticResource SettingsSmallButton}"
                                                        Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <!-- 最大内存 -->
                                            <TextBlock Text="最大内存" Foreground="#E0E0E0" FontFamily="Microsoft YaHei" FontSize="14" Margin="0,20,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SettingsVM.MaxMemoryText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource SettingsTextBox}" Width="120"
                                                         Grid.Column="0"/>
                                                <TextBlock Text="MB" Foreground="#999999" FontFamily="Microsoft YaHei" FontSize="13"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" Grid.Column="1"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 游戏页 -->
                                    <Grid Visibility="{Binding IsChecked, ElementName=NavGame, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="游戏设置" Foreground="#999999" FontFamily="Microsoft YaHei" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 关于页 -->
                                    <Grid Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="关于" Foreground="#999999" FontFamily="Microsoft YaHei" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
