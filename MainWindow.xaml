<Window x:Class="TWlauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TWlauncher"
        Title="时之旅者"
        Icon="Images/时旅@256x256.ico"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="Images/bg.png" Stretch="UniformToFill"/>
            </Border.Background>
            <Grid>
                <!-- 顶部拖动区域 -->
                <Rectangle Height="64" VerticalAlignment="Top" Fill="Transparent" MouseLeftButtonDown="MainDragMove"/>
                <!-- 左上角用户信息按钮 -->
                <Button Style="{StaticResource MainUser}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0"/>
                <!-- 右上角界面控制按钮 -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Orientation="Horizontal">
                    <Button Style="{StaticResource MainSetting}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource MainMinimize}" Click="MainMinimize_Click" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource MainClose}" Click="MainClose_Click" Margin="0,0,12,0"/>
                </StackPanel>
                <!-- 右下角通用操作按钮 -->
                <Button Content="启动游戏" Style="{StaticResource GameAction}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,64"/>
                <!-- 底部更新/下载信息栏 -->
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="24,0,24,16" Orientation="Vertical">
                    <!--文本-->
                    <TextBlock Text="下载进度：28.0%  1.2GB / 8.5GB" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#DDDDDD" FontFamily="Microsoft YaHei" FontSize="16" FontWeight="Bold"/>
                    <!-- 进度条 -->
                    <ProgressBar Style="{StaticResource GameProgressBar}" Value="28" Height="16" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
