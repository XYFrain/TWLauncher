<Window x:Class="TWlauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TWlauncher"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="Images/bg.png" Stretch="UniformToFill"/>
            </Border.Background>
            <Grid>
                <!-- 左上角用户信息按钮 -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" Orientation="Horizontal">
                    <Button Style="{StaticResource MainUser}"/>
                </StackPanel>
                <!-- 右上角界面控制按钮 -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0" Orientation="Horizontal">
                    <Button Style="{StaticResource MainSetting}"/>
                    <FrameworkElement Width="12"/>
                    <Button Style="{StaticResource MainMinimize}" Click="MainMinimize_Click"/>
                    <FrameworkElement Width="12"/>
                    <Button Style="{StaticResource MainClose}" Click="MainClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
